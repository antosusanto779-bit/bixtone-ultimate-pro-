        }

        function generateSongs() {
            const title = document.getElementById('songTitle').value || "Untitled Song";
            const mode = document.querySelector('input[name="genMode"]:checked').value;
            const vocal = document.getElementById('vocalType').value;
            const char = document.getElementById('vocalChar').value;
            const mood = document.getElementById('moodSelect').value;
            const bpm = document.getElementById('bpmSlider').value;
            const key = document.getElementById('keySelect').value;
            const instrument = document.getElementById('worldInstrument').value;

            document.getElementById('statusGen').innerText = "Memproses 3 Layer...";
            
            const container = document.getElementById('resultsContainer');
            container.innerHTML = `<div class="text-center py-12 text-slate-400"><i class="fa-solid fa-spinner fa-spin text-2xl text-bixtone-accent mb-2"></i><p class="text-sm">Synthesizing 3 Layers (Variatif, Balance, Wild)...</p></div>`;

            setTimeout(() => {
                document.getElementById('statusGen').innerText = "Selesai (3 Versi Ready)";
                
                const layers = [
                    { name: "Layer 1: Variatif", badge: "bg-purple-500/20 text-purple-300 border-purple-500/30", desc: "Aransemen dinamis & improvisasi kreatif unik." },
                    { name: "Layer 2: Balance", badge: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30", desc: "Standar industri pro, sangat harmonis & komersial." },
                    { name: "Layer 3: Wild", badge: "bg-amber-500/20 text-amber-300 border-amber-500/30", desc: "Agresif, distorsi tebal & gebrakan beat energik tak terduga." }
                ];

                let html = '';
                layers.forEach((l, idx) => {
                    html += `
                        <div class="bg-slate-900/90 rounded-xl p-3.5 border border-slate-800 space-y-2 hover:border-slate-700 transition">
                            <div class="flex justify-between items-center">
                                <span class="text-xs font-bold px-2 py-0.5 rounded-md border ${l.badge}">${l.name}</span>
                                <span class="text-[10px] text-slate-400">${mode} • ${vocal} • ${bpm} BPM</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-200">${title} (Ver. ${idx + 1})</h4>
                                <p class="text-[11px] text-slate-400">${l.desc} | Alat: ${instrument} | Key: ${key}</p>
                  
