    <script>
        function resetConfig() {
            document.getElementById('songTitle').value = "Simfoni Malam di Boyolali";
            document.getElementById('songLyrics').value = "Di bawah langit malam Boyolali, merajut nada menyapa dunia...";
            document.getElementById('bpmSlider').value = 110;
