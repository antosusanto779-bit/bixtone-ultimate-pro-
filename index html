<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bixtone Audio Labs V10.1 - Final A-Z Studio Generator</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        bixtone: {
                            blue: '#0284c7',
                            dark: '#0f172a',
                            card: '#1e293b',
                            accent: '#38bdf8'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-bixtone-dark text-slate-100 min-h-screen flex flex-col font-sans selection:bg-bixtone-blue selection:text-white">

    <!-- HEADER / BRANDING -->
    <header class="bg-slate-900/80 backdrop-blur border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-2">
            <div>
                <h1 class="text-xl font-bold tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-headphones-simple text-bixtone-accent"></i> BIXTONE AUDIO LABS <span class="text-xs bg-bixtone-blue text-white px-2 py-0.5 rounded-full">V10.1 FINAL</span>
                </h1>
                <p class="text-xs text-slate-400">Boyolali, Indonesia — Dari A Sampai Z Simple Konsisten</p>
            </div>
            <div class="text-xs text-bixtone-accent font-semibold tracking-wide bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
                FORGED IN BOYOLALI, INDONESIA - HEARD WORLDWIDE
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- PANEL KONTROL (A - O) -->
        <section class="lg:col-span-7 bg-bixtone-card rounded-2xl p-5 border border-slate-800 shadow-xl space-y-5">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h2 class="text-lg font-bold text-bixtone-accent"><i class="fa-solid fa-sliders"></i> Panel Konfigurasi A - O</h2>
                <button onclick="resetConfig()" class="text-xs text-rose-400 hover:text-rose-300 transition"><i class="fa-solid fa-rotate-right"></i> Reset A-O</button>
            </div>

            <!-- P - Pilihan Generate (Full Musik / Instrumen) -->
            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2"><i class="fa-solid fa-compact-disc"></i> P - Pilihan Generate Mode</label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex items-center gap-2 p-3 rounded-xl border border-slate-700 bg-slate-900/50 cursor-pointer hover:border-bixtone-blue transition">
                        <input type="radio" name="genMode" value="Full Musik" checked class="text-bixtone-blue focus:ring-bixtone-blue">
                        <span class="text-sm font-medium">FULL MUSIK (Vokal + Alat)</span>
                    </label>
                    <label class="flex items-center gap-2 p-3 rounded-xl border border-slate-700 bg-slate-900/50 cursor-pointer hover:border-bixtone-blue transition">
                        <input type="radio" name="genMode" value="Instrumen" class="text-bixtone-blue focus:ring-bixtone-blue">
                        <span class="text-sm font-medium">INSTRUMEN (No Vocal)</span>
                    </label>
                </div>
            </div>

            <!-- A - Vocal & B - Karakter Vokal -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-microphone"></i> A - Vocal Type</label>
                    <select id="vocalType" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="Male">A1 - Male Vocal (Solo Pria)</option>
                        <option value="Female">A2 - Female Vocal (Solo Wanita)</option>
                        <option value="Duet">A3 - Duet (Pria + Wanita Harmony)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-face-smile"></i> B - Karakter Vokal</label>
                    <select id="vocalChar" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="Romantic">Romantic (Romantis Lembut)</option>
                        <option value="Sad">Sad (Sedih Mendalam)</option>
                        <option value="Powerful">Powerful (Kuat Bertenaga)</option>
                        <option value="Happy">Happy (Ceria Bahagia)</option>
                        <option value="Energetic">Energetic (Energik Semangat)</option>
                        <option value="Melancholic">Melancholic (Melankolis Pilu)</option>
                        <option value="Epic">Epic (Megah Agung)</option>
                        <option value="Dark">Dark (Gelap Misterius)</option>
                    </select>
                </div>
            </div>

            <!-- C - Mood, BPM, Key -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">C1 - Mood</label>
                    <select id="moodSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="Romantic">Romantic (Love, Tender)</option>
                        <option value="Sad">Sad (Slow, Melancholic)</option>
                        <option value="Happy">Happy (Upbeat, Bright)</option>
                        <option value="Epic">Epic (Grand, Orchestral)</option>
                        <option value="Energetic">Energetic (Fast, Driving)</option>
                        <option value="Dark">Dark (Mysterious, Moody)</option>
                        <option value="Calm">Calm (Peaceful, Ambient)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">C2 - BPM (<span id="bpmVal">110</span>)</label>
                    <input type="range" id="bpmSlider" min="60" max="180" value="110" oninput="document.getElementById('bpmVal').innerText=this.value" class="w-full accent-bixtone-blue mt-2">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">C3 - Key</label>
                    <select id="keySelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="C Major">C Major (Happy Bright)</option>
                        <option value="D Minor">D Minor (Sad Melancholic)</option>
                        <option value="A Minor">A Minor (Lonely)</option>
                        <option value="G Major">G Major (Hopeful)</option>
                        <option value="E Major">E Major (Romantic)</option>
                        <option value="F Minor">F Minor (Dark)</option>
                    </select>
                </div>
            </div>

            <!-- D to N - Rangkuman Perangkat & Efek (Brand Safe) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                    <span class="text-slate-400 block font-semibold">D - MIC (70 Pilihan)</span>
                    <span class="text-slate-200">Neumann U87 / Shure SM7B</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                    <span class="text-slate-400 block font-semibold">E - GENRE (120 Komplit)</span>
                    <span class="text-slate-200">Pop, Rock, Metal, Dangdut</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                    <span class="text-slate-400 block font-semibold">F-G - GITAR & BASS</span>
                    <span class="text-slate-200">Fender, Gibson, Ibanez</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                    <span class="text-slate-400 block font-semibold">H-I - DRUM & CYMBALS</span>
                    <span class="text-slate-200">Yamaha, Pearl, Zildjian</span>
                </div>
            </div>

            <!-- O - Mastering & Alat Dunia -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-wand-magic-sparkles"></i> O1 - Mastering</label>
                    <select id="masteringType" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="Ozone 11">USA Loud Clean Perfect (Ozone 11 Type)</option>
                        <option value="Waves L2">USA Punch Loud (Waves L2 Type)</option>
                        <option value="FabFilter Pro-L2">Netherlands Transparent (FabFilter Type)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-globe"></i> O2 - Alat Dunia (200 Komplit)</label>
                    <select id="worldInstrument" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-sm focus:outline-none focus:border-bixtone-blue">
                        <option value="Piano & Strings">Grand Piano, Violin, Cello, Erhu</option>
                        <option value="Traditional Ethnic">Bagpipe, Sitar, Guzheng, Shakuhachi</option>
                        <option value="Wind & Brass">Saxophone Alto, Trumpet, Flute</option>
                        <option value="Modern Synth">Analog Synth, Hammond Organ, Rhodes</option>
                    </select>
                </div>
            </div>

            <!-- Q - Judul & Lirik / Panduan Mood -->
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-heading"></i> Q - Judul Lagu</label>
                    <input type="text" id="songTitle" value="Simfoni Malam di Boyolali" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm focus:outline-none focus:border-bixtone-blue">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"><i class="fa-solid fa-file-lines"></i> Q - Lirik / Panduan Mood</label>
                    <textarea id="songLyrics" rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm focus:outline-none focus:border-bixtone-blue">Di bawah langit malam Boyolali, merajut nada menyapa dunia...</textarea>
                </div>
            </div>

            <!-- Z - Tombol Generate 3 Layer -->
            <button onclick="generateSongs()" class="w-full bg-gradient-to-r from-cyan-600 to-bixtone-blue hover:from-cyan-500 hover:to-blue-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition transform active:scale-95 flex items-center justify-center gap-2 text-sm">
                <i class="fa-solid fa-rocket animate-bounce"></i> 🚀 GENERATE 3 VERSI (VARIATIF, BALANCE, WILD)
            </button>
        </section>

        <!-- PANEL HASIL (R - RESULT 3 VERSI) -->
        <section class="lg:col-span-5 flex flex-col gap-5">
            <div class="bg-bixtone-card rounded-2xl p-5 border border-slate-800 shadow-xl flex-grow flex flex-col">
                <div class="flex justify-between items-center border-b border-slate-700 pb-3 mb-4">
                    <h2 class="text-lg font-bold text-bixtone-accent"><i class="fa-solid fa-layer-group"></i> R - Result 3 Layer Versi</h2>
                    <span id="statusGen" class="text-xs text-slate-400">Menunggu Generate...</span>
                </div>

                <!-- Container 3 Versi (Variatif, Balance, Wild) -->
                <div id="resultsContainer" class="space-y-4 flex-grow flex flex-col justify-center">
                    <div class="text-center text-slate-500 py-10 border border-dashed border-slate-800 rounded-xl">
                        <i class="fa-solid fa-music text-3xl mb-2 opacity-40"></i>
                        <p class="text-sm">Klik tombol <span class="text-bixtone-accent font-semibold">Generate 3 Versi</span> di samping untuk memproses lagu.</p>
                    </div>
                </div>

                <!-- S - Aksi Global -->
                <div class="mt-4 pt-4 border-t border-slate-700/60 grid grid-cols-2 gap-2">
                    <button onclick="downloadAllZip()" class="bg-slate-800 hover:bg-slate-700 text-xs font-medium py-2.5 px-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-download text-bixtone-accent"></i> Download All ZIP
                    </button>
                    <button onclick="shareAll()" class="bg-slate-800 hover:bg-slate-700 text-xs font-medium py-2.5 px-3 rounded-xl border border-slate-700 transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-share-nodes text-bixtone-accent"></i> Share All Link
                    </button>
                </div>
            </div>

            <!-- T & U - Footer Branding Info -->
            <div class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800 text-center text-xs text-slate-400 space-y-1">
                <p class="font-bold text-slate-300">FORGED IN BOYOLALI, INDONESIA - HEARD WORLDWIDE</p>
                <p>B = Boyolali, I = Indonesia, IX = 9, TONES = Nada - Biru Favorit</p>
                <p class="text-slate-500 pt-1">© 2026 BIXTONE AUDIO LABS, BOYOLALI, INDONESIA</p>
            </div>
        </section>

    </main>

    <!-- SCRIPT APLIKASI -->
    <script>
        function resetConfig() {
            document.getElementById('songTitle').value = "Simfoni Malam di Boyolali";
            document.getElementById('songLyrics').value = "Di bawah langit malam Boyolali, merajut nada menyapa dunia...";
            document.getElementById('bpmSlider').value = 110;
            document.getElementById('bpmVal').innerText = "110";
            alert("Konfigurasi A-O berhasil di-reset ke default!");
        }

        function generateSongs() {
            const title = document.getElementById('songTitle').value || "Untitled Song";
            const mode = document.querySelector('input[name="genMode"]:checked').value;
            const vocal = document.getElementById('vocalType').value;
            const char = document.getElementById('vocalChar').value;
            const mood = document.getElementById('moodSelect').value;
            const bpm = document.getElementById('bpmSlider').value;
            const key = document.getElementById('keySelect').value;
            const instrument = document.getElementById('worldInstrument').value;

            document.getElementById('statusGen').innerText = "Memproses 3 Layer...";
            
            const container = document.getElementById('resultsContainer');
            container.innerHTML = `<div class="text-center py-12 text-slate-400"><i class="fa-solid fa-spinner fa-spin text-2xl text-bixtone-accent mb-2"></i><p class="text-sm">Synthesizing 3 Layers (Variatif, Balance, Wild)...</p></div>`;

            setTimeout(() => {
                document.getElementById('statusGen').innerText = "Selesai (3 Versi Ready)";
                
                const layers = [
                    { name: "Layer 1: Variatif", badge: "bg-purple-500/20 text-purple-300 border-purple-500/30", desc: "Eksperimental aransemen dinamis & improvisasi unik." },
                    { name: "Layer 2: Balance", badge: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30", desc: "Standar industri pro, harmonis, pas untuk komersial." },
                    { name: "Layer 3: Wild", badge: "bg-amber-500/20 text-amber-300 border-amber-500/30", desc: "Agresif, distorsi tebal, gebrakan beat tak terduga." }
                ];

                let html = '';
                layers.forEach((l, idx) => {
                    html += `
                        <div class="bg-slate-900/90 rounded-xl p-3.5 border border-slate-800 space-y-2 hover:border-slate-700 transition">
                            <div class="flex justify-between items-center">
                                <span class="text-xs font-bold px-2 py-0.5 rounded-md border ${l.badge}">${l.name}</span>
                                <span class="text-[10px] text-slate-400">${mode} • ${vocal} • ${bpm} BPM</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-200">${title} (Ver. ${idx + 1})</h4>
                                <p class="text-[11px] text-slate-400">${l.desc} | Alat: ${instrument} | Key: ${key}</p>
                            </div>
                            <div class="flex items-center justify-between pt-1 border-t border-slate-800/80 text-xs">
                                <button onclick="alert('Playing ${title} - ${l.name}')" class="text-bixtone-accent hover:underline flex items-center gap-1 font-medium"><i class="fa-solid fa-play"></i> Play Audio</button>
                                <div class="flex gap-2 text-slate-400">
                                    <button title="Download WAV/Stems" onclick="alert('Download ZIP ${l.name} started!')" class="hover:text-white"><i class="fa-solid fa-download"></i></button>
                                    <button title="Remake" onclick="generateSongs()" class="hover:text-white"><i class="fa-solid fa-rotate"></i></button>
                                    <button title="Share" onclick="alert('Link copied to clipboard!')" class="hover:text-white"><i class="fa-solid fa-share-nodes"></i></button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                container.innerHTML = html;
            }, 1000);
        }

        function downloadAllZip() {
            alert("Mengunduh seluruh paket ZIP (WAV 24bit + MP3 320 + FLAC + STEMS + Dolby Atmos 7.1.4)...");
        }

        function shareAll() {
            alert("Link hasil 3 versi berhasil disalin ke clipboard!");
        }
    </script>
</body>
</html>
